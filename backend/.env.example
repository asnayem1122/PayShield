# PayShield Backend Environment Configuration (Template)
# IMPORTANT: Do NOT store real secrets or production credentials in this repository.
# Copy this file to .env and adjust values for your local environment.

PROJECT_NAME="PayShield"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# PostgreSQL Server Connection
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="payshield_dev"

# Runtime Application Role (payshield_app: DML only, least-privilege)
POSTGRES_USER="payshield_app"
POSTGRES_PASSWORD="<STRONG_APP_PASSWORD_HERE>"

# Migration Role (payshield_migrator: DDL schema owner for Alembic)
MIGRATION_POSTGRES_USER="payshield_migrator"
MIGRATION_POSTGRES_PASSWORD="<STRONG_MIGRATOR_PASSWORD_HERE>"

# Direct URL Overrides (Optional - takes precedence over individual components)
# DATABASE_URL_OVERRIDE="postgresql+psycopg://payshield_app:password@127.0.0.1:5432/payshield_dev"
# MIGRATION_DATABASE_URL_OVERRIDE="postgresql+psycopg://payshield_migrator:password@127.0.0.1:5432/payshield_dev"

# Connection Pool Settings
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security & JWT Configuration (Minimum 32 cryptographically random characters)
JWT_SECRET_KEY="<GENERATE_32_PLUS_CHAR_CRYPTOGRAPHIC_SECRET_KEY>"
SECRET_KEY="<GENERATE_32_PLUS_CHAR_CRYPTOGRAPHIC_SECRET_KEY>"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Canonical Demo User Passwords (Required for seed_demo_users.py and --rotate-passwords)
PAYSHIELD_MERCHANT_PASSWORD="<STRONG_DEMO_MERCHANT_PASSWORD_MIN_8_CHARS>"
PAYSHIELD_ANALYST_PASSWORD="<STRONG_DEMO_ANALYST_PASSWORD_MIN_8_CHARS>"
PAYSHIELD_ADMIN_PASSWORD="<STRONG_DEMO_ADMIN_PASSWORD_MIN_8_CHARS>"
