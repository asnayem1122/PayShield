# PayShield Backend Environment Configuration (Template)
# IMPORTANT: Do NOT store real secrets or production credentials in this file.

PROJECT_NAME="PayShield"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# PostgreSQL Configuration (Template for future milestone - not active in Milestone 0)
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="payshield_dev"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_dev_password"

# Security (Template for future authentication milestone)
SECRET_KEY="development_secret_key_never_use_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
